# Server
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/portfolio

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Production Database Credentials (for docker-compose.prod.yml)
MONGO_USER=admin
MONGO_PASSWORD=secure_password_here
REDIS_PASSWORD=secure_redis_password_here

# DockerHub Credentials
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_token

# NASA API
NASA_API_KEY=your_nasa_api_key

# Sentry (error tracking)
SENTRY_DSN=sentry_key

# -----------------------------------------------------------------------
# Stripe Payments
# -----------------------------------------------------------------------
# Base URL of the frontend — no trailing slash, no path suffix.
# Used to build cancel_url and success_url for Stripe checkout sessions.
# Dev example:  http://localhost:3000
# Prod example: https://luisfaria.dev
FRONTEND_URL=http://localhost:3000

# Stripe secret key — backend only, never expose to the client.
# Find it at: https://dashboard.stripe.com/apikeys
# Use sk_test_... for local development; sk_live_... for production.
STRIPE_SECRET_KEY=sk_test_xxxx

# Stripe webhook signing secret — verifies POST /webhooks/stripe (records Payments).
# Local dev: run `stripe listen --forward-to localhost:4000/webhooks/stripe` and paste the printed whsec_.
# Production: https://dashboard.stripe.com/webhooks → endpoint https://luisfaria.dev/webhooks/stripe
#   with checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.async_payment_failed and charge.refunded → copy signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Discord webhook for server-side notifications (e.g. "💰 paid AUD 5.00 — coffee").
# Optional: notifications are skipped when unset.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx

# Cal.com booking link for paid meetings (a hidden event type).
# Shown on /payment/success and emailed only after a meeting Payment is paid.
CAL_MEETING_URL=https://cal.com/your-user/consulting-session

# Stripe Price IDs for each product.
# Create test prices at: https://dashboard.stripe.com/test/products
#   1. Create a product (e.g. "Coffee")
#   2. Add a one-time price (e.g. AUD 5)
#   3. Copy the Price ID (starts with price_)
# Use price_test_... IDs for local/test; price_... IDs for live.
STRIPE_COFFEE_PRICE_ID=price_xxxx
STRIPE_MEETING_PRICE_ID=price_xxxx

# Server-side Google Geocoding API key. Do not expose this in NEXT_PUBLIC_* envs.
# Restrict in Google Cloud to Geocoding API only.
GEOCODING_API_KEY=XXXXXX

# Relationship map — admin-only home marker (optional).
# Returned by the admin-gated `relationshipHomeLocation` GraphQL query.
# DO NOT expose any of these via NEXT_PUBLIC_* — they would leak into the browser bundle.
# Leave blank to disable the home marker on /admin/relationship.
RELATIONSHIP_HOME_LAT=
RELATIONSHIP_HOME_LNG=
RELATIONSHIP_HOME_LABEL="Home base"
