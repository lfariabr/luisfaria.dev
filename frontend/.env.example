NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Browser key for Maps JavaScript API only. This value is public in the browser.
# Restrict it in Google Cloud to trusted HTTP referrers and Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps Map ID for AdvancedMarker support. Create one in:
# Google Cloud Console -> Google Maps Platform -> Map Management.
# DEMO_MAP_ID is acceptable only for local testing.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
